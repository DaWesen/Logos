# ==================== Logos 微服务系统 - 环境配置 ====================
# 复制此文件为 .env 并修改相应配置
# cp .env.example .env

# ==================== 数据库配置 ====================
POSTGRES_USER=logos
POSTGRES_PASSWORD=logos123456
POSTGRES_DB=logos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123456

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=logos-documents

MILVUS_HOST=localhost
MILVUS_PORT=19530

ELASTICSEARCH_URL=http://localhost:9200

ETCD_ENDPOINTS=localhost:2379

KAFKA_BROKERS=localhost:9093

# ==================== JWT 配置 ====================
JWT_SECRET=your-secret-key-change-in-production-please-use-strong-random-string

# ==================== AI 模型配置 ====================
# 火山方舟 ARK 平台 API Key
ARK_API_KEY=your-ark-api-key-here
# ARK 模型端点 ID
ARK_MODEL=ep-20240806150409-xxxxx
# ARK Base URL（默认 https://api.openai.com/v1，使用 DeepSeek 填 https://api.deepseek.com/v1）
ARK_BASE_URL=
# Embedding 模型名称
EMBEDDING_MODEL=embedding-3

# ==================== 服务端口配置 ====================
GATEWAY_PORT=8888
USER_SERVICE_PORT=9001
KNOWLEDGE_SERVICE_PORT=9002
SEARCH_SERVICE_PORT=9003
VECTOR_SERVICE_PORT=9004
QUESTION_SERVICE_PORT=9005
RECOMMEND_SERVICE_PORT=9006
EXTRACTION_SERVICE_PORT=9007
COLLECTION_SERVICE_PORT=9008
MESSAGE_SERVICE_PORT=9009
MONITORING_SERVICE_PORT=9010
IM_SERVICE_PORT=9011
CHAT_SERVICE_PORT=9012
CONTACT_SERVICE_PORT=9013
PROCESS_SERVICE_PORT=9016
SUMMARY_SERVICE_PORT=9017
MCP_SERVICE_PORT=9018
MODERATION_SERVICE_PORT=9019
BOT_SERVICE_PORT=9020
BILLING_SERVICE_PORT=9021

# ==================== 基础设施端口 ====================
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9093
ZOOKEEPER_PORT=2182
ETCD_PORT=2379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9901
MILVUS_PORT=19530
ELASTICSEARCH_PORT=9200
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ==================== 可观测性端口 ====================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
KIALI_PORT=20001

# ==================== 监控配置 ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ==================== 限流配置 ====================
GLOBAL_RATE_LIMIT=120
IP_RATE_LIMIT=200
LOGIN_RATE_LIMIT=5
QUESTION_RATE_LIMIT=30
EXTRACTION_RATE_LIMIT=20
MESSAGE_RATE_LIMIT=50
RECOMMEND_RATE_LIMIT=60

# ==================== Kafka 配置 ====================
KAFKA_PARTITIONS=7
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_HOURS=168

# ==================== 系统工具依赖 ====================
# FFmpeg 路径（视频抽帧功能需要，process 服务使用）
FFMPEG_PATH=ffmpeg

# ==================== 服务治理配置 ====================
# gRPC 超时
GRPC_CLIENT_TIMEOUT=30s
GRPC_SERVER_TIMEOUT=30s
# 熔断器
CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
CIRCUIT_BREAKER_TIMEOUT=10s
# 重试
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=200ms

# ==================== 入口安全 ====================
# 需要跨域携带 Cookie 时配置来源白名单（逗号分隔）；留空则通配但不允许凭据
CORS_ALLOWED_ORIGINS=
# 部署在 nginx/ingress 后时配置代理 IP/CIDR（逗号分隔）；留空表示不信任任何代理
TRUSTED_PROXIES=
# 外部系统（QQ Bridge / LLOneBot）访问本服务的绝对地址。
# 媒体代理返回的是相对路径，出站到外部系统前需要拼成绝对 URL；留空则跳过媒体段。
LOGOS_PUBLIC_BASE_URL=

# ==================== QQ Bridge ====================
# 与 LLOneBot 对接；WS_PORT>0 时为 Server 模式，否则用 WS_FORWARD_URL 主动连接
QQBRIDGE_ENABLED=false
QQBRIDGE_WS_PORT=6701
QQBRIDGE_WS_FORWARD_URL=ws://127.0.0.1:3001
# 入站媒体临时目录，留空使用系统临时目录下的 qqbridge
QQBRIDGE_TEMP_DIR=
# 快速路径（直接调 Bot）并发上限，默认 4；每条消息都会触发一次 LLM 调用
QQBRIDGE_FAST_CONCURRENCY=
# 媒体中转（下载+上传）并发上限，默认 8
QQBRIDGE_MEDIA_CONCURRENCY=
# 单个 QQ 媒体文件上限（MB），默认 100
QQBRIDGE_MEDIA_MAX_MB=
# 单条消息媒体中转总预算（秒），默认 90；过小会让大文件必然失败
QQBRIDGE_MEDIA_TIMEOUT_SECONDS=

# ==================== 前端配置 ====================
VITE_API_BASE_URL=http://localhost:8888
VITE_WS_URL=ws://localhost:8888/ws
